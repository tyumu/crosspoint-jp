# X3DP 個人設定のテンプレート
#
#   1. このファイルを同じ場所に `.env` としてコピーする
#   2. 自分の値を書く(コメントを外す)
#
# `.env` は .gitignore 済みで、リポジトリには入りません。
# 環境変数が設定されていればそちらが優先されます。
# 未設定の項目は C 側の既定値(公開リポジトリの GitHub API)が使われます。

# --- OTA の取得先(自前の配信サーバを使う場合) ---
# 安定版の問い合わせ先。GitHub Releases API 形式の JSON を返す URL
#X3DP_OTA_LATEST_URL=http://192.168.1.10:8080/latest.json
# RC / Dev チャネル用のリリース一覧
#X3DP_OTA_LIST_URL=http://192.168.1.10:8080/latest.json

# --- ファームの版表記 ---
# 設定すると設定画面のバージョン表示がこの値になる(焼いたビルドの識別用)
# 未設定ならスクリプトが git のタグ/ブランチ/SHA から組み立てる
#X3DP_VERSION=2.5.0-jp
